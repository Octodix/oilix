generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OliveType {
  GREEN
  RIPE
  ZBOUCH
}

enum EntryStatus {
  RECEIVED
  IN_STORAGE
  PRESSED
  OIL_COLLECTED
  PAID
  COMPLETED
  CANCELLED
}

