/**
 * Manual deductions (retenues). Automatic ones (absence/late) are computed by payroll.
 */
model HrDeduction {
  id            String           @id @default(uuid())
  employeeId    String           @map("employee_id")
  employee      HrEmployee       @relation(fields: [employeeId], references: [id])
  deductionType String           @map("deduction_type")
  amount        Decimal          @db.Decimal(14, 2)
  year          Int
  month         Int
  reason        String
  status        HrApprovalStatus @default(PENDING)
  createdById   String?          @map("created_by_id")
  createdByName String?          @map("created_by_name")
  decidedById   String?          @map("decided_by_id")
  decidedByName String?          @map("decided_by_name")
  decidedAt     DateTime?        @map("decided_at")
  payslipId     String?          @map("payslip_id")
  payslip       HrPayslip?       @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, year, month])
  @@index([status])
  @@map("hr_deductions")
}

model HrPayrollPeriod {
  id               String            @id @default(uuid())
  year             Int
  month            Int
  status           HrPayrollStatus   @default(DRAFT)
  startDate        DateTime          @map("start_date") @db.Date
  endDate          DateTime          @map("end_date") @db.Date
  /**
   * HR policy in force when the period was validated
   */
  settingsSnapshot Json?             @map("settings_snapshot")
  employeeCount    Int               @default(0) @map("employee_count")
  totalGross       Decimal           @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions  Decimal           @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet         Decimal           @default(0) @map("total_net") @db.Decimal(14, 2)
  totalPaid        Decimal           @default(0) @map("total_paid") @db.Decimal(14, 2)
  warnings         Json?
  notes            String?
  calculatedAt     DateTime?         @map("calculated_at")
  calculatedById   String?           @map("calculated_by_id")
  calculatedByName String?           @map("calculated_by_name")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewedById     String?           @map("reviewed_by_id")
  reviewedByName   String?           @map("reviewed_by_name")
  validatedAt      DateTime?         @map("validated_at")
  validatedById    String?           @map("validated_by_id")
  validatedByName  String?           @map("validated_by_name")
  paidAt           DateTime?         @map("paid_at")
  closedAt         DateTime?         @map("closed_at")
  closedById       String?           @map("closed_by_id")
  closedByName     String?           @map("closed_by_name")
  payslips         HrPayslip[]
  payments         HrSalaryPayment[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([year, month])
  @@map("hr_payroll_periods")
}

/**
 * Bulletin de paie — every value is a snapshot; validated rows are never recomputed.
 */
model HrPayslip {
  id                String            @id @default(uuid())
  periodId          String            @map("period_id")
  period            HrPayrollPeriod   @relation(fields: [periodId], references: [id])
  employeeId        String            @map("employee_id")
  employee          HrEmployee        @relation(fields: [employeeId], references: [id])
  /**
   * CALCULATED | VALIDATED
   */
  status            String            @default("CALCULATED")
  employeeSnapshot  Json              @map("employee_snapshot")
  contractId        String?           @map("contract_id")
  contractSnapshot  Json?             @map("contract_snapshot")
  attendanceSummary Json              @map("attendance_summary")
  salaryMode        HrSalaryMode      @map("salary_mode")
  baseSalary        Decimal           @map("base_salary") @db.Decimal(14, 2)
  dailyRate         Decimal           @map("daily_rate") @db.Decimal(14, 4)
  hourlyRate        Decimal           @map("hourly_rate") @db.Decimal(14, 4)
  grossEarnings     Decimal           @map("gross_earnings") @db.Decimal(14, 2)
  totalDeductions   Decimal           @map("total_deductions") @db.Decimal(14, 2)
  netSalary         Decimal           @map("net_salary") @db.Decimal(14, 2)
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(14, 2)
  /**
   * UNPAID | PARTIAL | PAID
   */
  paymentStatus     String            @default("UNPAID") @map("payment_status")
  warnings          Json?
  calculatedAt      DateTime          @default(now()) @map("calculated_at")
  lockedAt          DateTime?         @map("locked_at")
  notes             String?
  lines             HrPayslipLine[]
  payments          HrSalaryPayment[]
  overtimes         HrOvertime[]
  advances          HrAdvance[]
  loanRepayments    HrLoanRepayment[]
  bonuses           HrBonus[]
  deductions        HrDeduction[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@map("hr_payslips")
}

model HrPayslipLine {
  id          String    @id @default(uuid())
  payslipId   String    @map("payslip_id")
  payslip     HrPayslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  /**
   * EARNING | DEDUCTION
   */
  kind        String
  code        String
  label       String
  labelFr     String?   @map("label_fr")
  quantity    Decimal?  @db.Decimal(12, 2)
  unit        String?
  rate        Decimal?  @db.Decimal(14, 4)
  amount      Decimal   @db.Decimal(14, 2)
  sourceType  String?   @map("source_type")
  sourceIds   String[]  @default([]) @map("source_ids")
  explanation String
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([payslipId])
  @@map("hr_payslip_lines")
}

/**
 * Actual money paid — separate from payroll calculation. Cash payments post once to the register.
 */
model HrSalaryPayment {
  id               String               @id @default(uuid())
  payslipId        String               @map("payslip_id")
  payslip          HrPayslip            @relation(fields: [payslipId], references: [id])
  periodId         String               @map("period_id")
  period           HrPayrollPeriod      @relation(fields: [periodId], references: [id])
  employeeId       String               @map("employee_id")
  employee         HrEmployee           @relation(fields: [employeeId], references: [id])
  amount           Decimal              @db.Decimal(14, 2)
  paidAt           DateTime             @map("paid_at")
  paymentMethod    String               @map("payment_method")
  cashRegisterId   String?              @map("cash_register_id")
  cashRegister     CashRegister?        @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  cashSessionId    String?              @map("cash_session_id")
  cashSession      CashRegisterSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  cashRegisterName String?              @map("cash_register_name")
  reference        String?
  notes            String?
  /**
   * POSTED | CANCELLED
   */
  status           String               @default("POSTED")
  idempotencyKey   String               @unique @map("idempotency_key")
  paidById         String               @map("paid_by_id")
  paidByName       String?              @map("paid_by_name")
  cancelledAt      DateTime?            @map("cancelled_at")
  cancelledById    String?              @map("cancelled_by_id")
  cancelledByName  String?              @map("cancelled_by_name")
  cancelReason     String?              @map("cancel_reason")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([payslipId])
  @@index([periodId])
  @@index([employeeId, paidAt])
  @@index([cashSessionId])
  @@map("hr_salary_payments")
}

/**
 * Other personnel costs. Salaries/advances/loans are NOT re-entered here (reported from their own tables).
 */
model HrExpense {
  id               String               @id @default(uuid())
  category         String
  amount           Decimal              @db.Decimal(14, 2)
  date             DateTime             @db.Date
  employeeId       String?              @map("employee_id")
  employee         HrEmployee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  description      String
  paymentMethod    String               @map("payment_method")
  cashRegisterId   String?              @map("cash_register_id")
  cashRegister     CashRegister?        @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  cashSessionId    String?              @map("cash_session_id")
  cashSession      CashRegisterSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  cashRegisterName String?              @map("cash_register_name")
  reference        String?
  /**
   * POSTED | CANCELLED
   */
  status           String               @default("POSTED")
  idempotencyKey   String?              @unique @map("idempotency_key")
  createdById      String?              @map("created_by_id")
  createdByName    String?              @map("created_by_name")
  cancelledAt      DateTime?            @map("cancelled_at")
  cancelledById    String?              @map("cancelled_by_id")
  cancelledByName  String?              @map("cancelled_by_name")
  cancelReason     String?              @map("cancel_reason")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([date])
  @@index([category])
  @@map("hr_expenses")
}

// ─── Mill operator assistance (مساعدة المشغّل الرئيسي) ──────────────────────
// An assistant collects money on the primary operator's behalf from another workstation.
// Payments stay the only revenue records; a session only groups them and tracks the
// physical handover of the collected cash. A handover is an internal transfer, never income.

enum MillAssistanceStatus {
  ACTIVE
  AWAITING_CONFIRMATION
  CONFIRMED
  DISCREPANCY
}

model MillAssistanceSession {
  id                  String               @id @default(uuid())
  seasonId            String               @map("season_id")
  season              Season               @relation(fields: [seasonId], references: [id])
  sessionNumber       Int                  @map("session_number")
  status              MillAssistanceStatus @default(ACTIVE)
  primaryOperatorId   String               @map("primary_operator_id")
  primaryOperator     User                 @relation("MillAssistPrimary", fields: [primaryOperatorId], references: [id])
  assistantId         String               @map("assistant_id")
  assistant           User                 @relation("MillAssistAssistant", fields: [assistantId], references: [id])
  assistantDeviceId   String?              @map("assistant_device_id")
  assistantDevice     Device?              @relation("MillAssistAssistantDevice", fields: [assistantDeviceId], references: [id])
  primaryDeviceId     String?              @map("primary_device_id")
  primaryDevice       Device?              @relation("MillAssistPrimaryDevice", fields: [primaryDeviceId], references: [id])
  /**
   * Name snapshots so the handover receipt stays accurate after renames
   */
  primaryOperatorName String?              @map("primary_operator_name")
  assistantName       String?              @map("assistant_name")
  assistantDeviceName String?              @map("assistant_device_name")
  startedAt           DateTime             @default(now()) @map("started_at")
  closedAt            DateTime?            @map("closed_at")
  /**
   * Totals frozen when the assistant closes the session
   */
  operationsCount     Int                  @default(0) @map("operations_count")
  paymentsCount       Int                  @default(0) @map("payments_count")
  totalCharged        Decimal              @default(0) @map("total_charged") @db.Decimal(14, 2)
  totalCollected      Decimal              @default(0) @map("total_collected") @db.Decimal(14, 2)
  totalCash           Decimal              @default(0) @map("total_cash") @db.Decimal(14, 2)
  totalNonCash        Decimal              @default(0) @map("total_non_cash") @db.Decimal(14, 2)
  totalOutstanding    Decimal              @default(0) @map("total_outstanding") @db.Decimal(14, 2)
  /**
   * Cash the assistant must hand over = totalCash
   */
  expectedHandover    Decimal              @default(0) @map("expected_handover") @db.Decimal(14, 2)
  /**
   * Cash the assistant counted and declared
   */
  declaredHandover    Decimal?             @map("declared_handover") @db.Decimal(14, 2)
  /**
   * declared − expected (negative = missing cash)
   */
  difference          Decimal              @default(0) @db.Decimal(14, 2)
  discrepancyNote     String?              @map("discrepancy_note")
  confirmedAt         DateTime?            @map("confirmed_at")
  confirmedById       String?              @map("confirmed_by_id")
  confirmedBy         User?                @relation("MillAssistConfirmedBy", fields: [confirmedById], references: [id])
  /**
   * Cash the primary operator actually counted on receipt (may differ from declared)
   */
  receivedHandover    Decimal?             @map("received_handover") @db.Decimal(14, 2)
  resolvedAt          DateTime?            @map("resolved_at")
  resolvedById        String?              @map("resolved_by_id")
  resolvedBy          User?                @relation("MillAssistResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote      String?              @map("resolution_note")
  notes               String?
  payments            Payment[]
  pressingRecords     PressingRecord[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([seasonId, sessionNumber])
  @@index([assistantId, status])
  @@index([primaryOperatorId, status])
  @@index([seasonId, status])
  @@map("mill_assistance_sessions")
}
