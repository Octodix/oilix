/**
 * مصدر الزيت للبيع بالتجزئة
 */
enum OilSource {
  STORED
  FARMER
}

/**
 * نوع الزيت للبيع بالتجزئة (مستقل عن نوع الزيتون)
 */
enum OilType {
  GREEN
  TAIEB
  DROU
  ZEBBOUCHE
}

enum OilStockMovementType {
  STOCK_ADDITION
  SALE
  SALE_CANCELLATION
  INVENTORY_COUNT
  INVENTORY_ADJUSTMENT
  ADJUSTMENT
  LOSS
  MANUAL_CORRECTION
}

enum OilSaleStatus {
  COMPLETED
  CANCELLED
}

enum OilSalePaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum OilCustomerLedgerType {
  SALE_DEBT
  PAYMENT
  REFUND
  SALE_CANCELLATION
  DEBT_ADJUSTMENT
}

enum OilSaleLineKind {
  CONTAINER
  LOOSE
  CONTAINER_ONLY
}

enum OilContainerStockMovementType {
  PURCHASE
  STOCK_ADDITION
  OIL_SALE_CONSUMPTION
  DIRECT_CONTAINER_SALE
  SALE_CANCELLATION
  INVENTORY_COUNT
  INVENTORY_ADJUSTMENT
  DAMAGE
  LOSS
  ADJUSTMENT
  MANUAL_CORRECTION
}

enum OilInventoryDifferenceType {
  LOSS
  SURPLUS
  BALANCED
}

enum OilPricingMode {
  PER_LITRE
  FIXED_CONTAINER
}

enum DeviceStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum DeviceWorkspace {
  SALES
  MILL
  BOTH
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  nameAr      String       @map("name_ar")
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id                       String                       @id @default(uuid())
  username                 String                       @unique
  email                    String?                      @unique
  passwordHash             String                       @map("password_hash")
  firstName                String?                      @map("first_name")
  lastName                 String?                      @map("last_name")
  isActive                 Boolean                      @default(true) @map("is_active")
  roleId                   String                       @map("role_id")
  role                     Role                         @relation(fields: [roleId], references: [id])
  /**
   * صلاحيات مستقلة عن الدور — إن كانت فارغة يُورَث الدور
   */
  permissions              Permission[]
  auditLogs                AuditLog[]
  oliveEntries             OliveEntry[]
  pressingRecords          PressingRecord[]
  filtrationRecords        FiltrationRecord[]
  filtrationUpdates        FiltrationRecord[]           @relation("FiltrationUpdatedBy")
  payments                 Payment[]
  oilSalesCreated          OilSale[]                    @relation("OilSaleCreatedBy")
  oilSalesCancelled        OilSale[]                    @relation("OilSaleCancelledBy")
  oilStockMovements        OilStockMovement[]
  oilInventoryCounts       OilInventoryCount[]
  oilCustomersCreated      OilSaleCustomer[]            @relation("OilCustomerCreatedBy")
  oilContainerMovements    OilContainerStockMovement[]
  oilContainerCounts       OilContainerInventoryCount[]
  oilSalePayments          OilSalePayment[]
  oilCustomerLedgerEntries OilCustomerLedgerEntry[]
  devicesApproved          Device[]                     @relation("DeviceApprovedBy")
  cashSessionsOpened       CashRegisterSession[]        @relation("CashSessionOpenedBy")
  cashSessionsClosed       CashRegisterSession[]        @relation("CashSessionClosedBy")
  oilDayReportPrints       OilDayReportPrint[]
  millAssistAsPrimary      MillAssistanceSession[]      @relation("MillAssistPrimary")
  millAssistAsAssistant    MillAssistanceSession[]      @relation("MillAssistAssistant")
  millAssistConfirmed      MillAssistanceSession[]      @relation("MillAssistConfirmedBy")
  millAssistResolved       MillAssistanceSession[]      @relation("MillAssistResolvedBy")
  /**
   * Optional link: an employee may (or may not) have an Oilix login
   */
  hrEmployee               HrEmployee?
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  deletedAt                DateTime?                    @map("deleted_at")

  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

model Client {
  id           String       @id @default(uuid())
  seasonId     String       @map("season_id")
  season       Season       @relation(fields: [seasonId], references: [id])
  oliveType    OliveType    @map("olive_type")
  clientNumber Int          @map("client_number")
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  phone        String?
  notes        String?
  oliveEntries OliveEntry[]
  deviceId     String?      @map("device_id")
  device       Device?      @relation(fields: [deviceId], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  @@unique([seasonId, oliveType, clientNumber])
  @@index([seasonId])
  @@index([seasonId, oliveType])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([deletedAt])
  @@index([deviceId])
  @@map("clients")
}

model Season {
  id                       String                       @id @default(uuid())
  name                     String
  startDate                DateTime                     @map("start_date")
  endDate                  DateTime?                    @map("end_date")
  isActive                 Boolean                      @default(true) @map("is_active")
  clients                  Client[]
  oliveEntries             OliveEntry[]
  filtrationRecords        FiltrationRecord[]
  oilSaleCustomers         OilSaleCustomer[]
  oilStockBalances         OilStockBalance[]
  oilStockMovements        OilStockMovement[]
  oilInventoryCounts       OilInventoryCount[]
  oilSales                 OilSale[]
  oilSalePayments          OilSalePayment[]
  oilCustomerLedgerEntries OilCustomerLedgerEntry[]
  oilContainerBalances     OilContainerStockBalance[]
  oilContainerMovements    OilContainerStockMovement[]
  oilContainerCounts       OilContainerInventoryCount[]
  cashSessions             CashRegisterSession[]
  oilDayReportPrints       OilDayReportPrint[]
  millAssistanceSessions   MillAssistanceSession[]
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")

  @@map("seasons")
}

model OliveEntry {
  id               String          @id @default(uuid())
  referenceNumber  Int             @map("reference_number")
  clientId         String          @map("client_id")
  client           Client          @relation(fields: [clientId], references: [id])
  seasonId         String          @map("season_id")
  season           Season          @relation(fields: [seasonId], references: [id])
  oliveType        OliveType       @map("olive_type")
  bagCount         Int             @map("bag_count")
  adhlefCount      Int?            @map("adhlef_count")
  capacity         Decimal?        @db.Decimal(10, 2)
  totalWeightKg    Decimal         @map("total_weight_kg") @db.Decimal(10, 2)
  status           EntryStatus     @default(RECEIVED)
  isNonReferential Boolean         @default(false) @map("is_non_referential")
  notes            String?
  notes2           String?         @map("notes2")
  entryDate        DateTime        @default(now()) @map("entry_date")
  entryTime        String          @map("entry_time")
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id])
  deviceId         String?         @map("device_id")
  device           Device?         @relation(fields: [deviceId], references: [id])
  weights          EntryWeight[]
  pressingRecord   PressingRecord?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  @@unique([seasonId, oliveType, referenceNumber])
  @@index([clientId])
  @@index([seasonId])
  @@index([status])
  @@index([entryDate])
  @@index([oliveType])
  @@index([deletedAt])
  @@index([deviceId])
  @@map("olive_entries")
}

model EntryWeight {
  id           String     @id @default(uuid())
  oliveEntryId String     @map("olive_entry_id")
  oliveEntry   OliveEntry @relation(fields: [oliveEntryId], references: [id], onDelete: Cascade)
  weighRound   Int        @default(1) @map("weigh_round")
  bagNumber    Int        @map("bag_number")
  weightKg     Decimal    @map("weight_kg") @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([oliveEntryId])
  @@map("entry_weights")
}

model PressingRecord {
  id                  String                 @id @default(uuid())
  oliveEntryId        String                 @unique @map("olive_entry_id")
  oliveEntry          OliveEntry             @relation(fields: [oliveEntryId], references: [id])
  oilQuantityL        Decimal                @map("oil_quantity_l") @db.Decimal(10, 2)
  region              String?
  zayat               String?
  yieldPercent        Decimal?               @map("yield_percent") @db.Decimal(5, 2)
  amount              Decimal                @db.Decimal(12, 2)
  aidAmount           Decimal                @default(0) @map("aid_amount") @db.Decimal(12, 2)
  oilCollected        Boolean                @default(false) @map("oil_collected")
  paid                Boolean                @default(false)
  notes               String?
  notes2              String?                @map("notes2")
  pickupDate          DateTime?              @map("pickup_date")
  treatmentDate       DateTime               @default(now()) @map("treatment_date")
  treatmentTime       String                 @map("treatment_time")
  userId              String                 @map("user_id")
  user                User                   @relation(fields: [userId], references: [id])
  deviceId            String?                @map("device_id")
  device              Device?                @relation(fields: [deviceId], references: [id])
  payments            Payment[]
  /**
   * Assistance session during which this operation was recorded (traceability only).
   */
  assistanceSessionId String?                @map("assistance_session_id")
  assistanceSession   MillAssistanceSession? @relation(fields: [assistanceSessionId], references: [id])
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@index([treatmentDate])
  @@index([paid])
  @@index([oilCollected])
  @@index([deviceId])
  @@map("pressing_records")
}

/**
 * عمليات تصفية الزيت — تطبيق Oilix Filtration
 */
model FiltrationRecord {
  id              String    @id @default(uuid())
  seasonId        String    @map("season_id")
  season          Season    @relation(fields: [seasonId], references: [id])
  oliveType       OliveType @map("olive_type")
  referenceNumber Int       @map("reference_number")
  zayatName       String    @map("zayat_name")
  region          String    @default("")
  quantityL       Decimal   @map("quantity_l") @db.Decimal(12, 2)
  khallaf         Decimal   @default(0) @db.Decimal(12, 2)
  notes           String?
  createdById     String    @map("created_by_id")
  createdBy       User      @relation(fields: [createdById], references: [id])
  deviceId        String?   @map("device_id")
  device          Device?   @relation(fields: [deviceId], references: [id])
  updatedById     String?   @map("updated_by_id")
  updatedBy       User?     @relation("FiltrationUpdatedBy", fields: [updatedById], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([seasonId, oliveType, referenceNumber])
  @@index([seasonId])
  @@index([seasonId, oliveType])
  @@index([oliveType])
  @@index([zayatName])
  @@index([region])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deviceId])
  @@map("filtration_records")
}

model Payment {
  id                  String                 @id @default(uuid())
  pressingRecordId    String                 @map("pressing_record_id")
  pressingRecord      PressingRecord         @relation(fields: [pressingRecordId], references: [id])
  amount              Decimal                @db.Decimal(12, 2)
  paymentDate         DateTime               @default(now()) @map("payment_date")
  paymentTime         String                 @map("payment_time")
  method              String?
  notes               String?
  userId              String                 @map("user_id")
  user                User                   @relation(fields: [userId], references: [id])
  deviceId            String?                @map("device_id")
  device              Device?                @relation(fields: [deviceId], references: [id])
  /**
   * Set when the payment was collected by an assistant inside an assistance session (never twice).
   */
  assistanceSessionId String?                @map("assistance_session_id")
  assistanceSession   MillAssistanceSession? @relation(fields: [assistanceSessionId], references: [id])
  createdAt           DateTime               @default(now()) @map("created_at")

  @@index([pressingRecordId])
  @@index([assistanceSessionId])
  @@index([paymentDate])
  @@index([deviceId])
  @@map("payments")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  deviceId    String?  @map("device_id")
  device      Device?  @relation(fields: [deviceId], references: [id])
  workspace   String?
  deviceCode  String?  @map("device_code")
  action      String
  module      String   @default("system")
  description String?
  entity      String
  entityId    String?  @map("entity_id")
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  source      String?  @default("web")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([deviceId])
  @@index([workspace])
  @@index([module])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  payload   Json?
  read      Boolean  @default(false)
  seasonId  String?  @map("season_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([read, createdAt])
  @@index([seasonId])
  @@map("notifications")
}

model ReportSnapshot {
  id          String   @id @default(uuid())
  seasonId    String?  @map("season_id")
  reportType  String   @map("report_type")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  data        Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([reportType, periodStart])
  @@map("report_snapshots")
}

/**
 * زبائن بيع الزيت — مستقلون عن زبائن المعصرة
 */
model OilSaleCustomer {
  id            String                   @id @default(uuid())
  seasonId      String                   @map("season_id")
  season        Season                   @relation(fields: [seasonId], references: [id])
  name          String
  phone         String?
  address       String?
  wilaya        String?
  commune       String?
  notes         String?
  createdById   String?                  @map("created_by_id")
  createdBy     User?                    @relation("OilCustomerCreatedBy", fields: [createdById], references: [id])
  sales         OilSale[]
  payments      OilSalePayment[]
  ledgerEntries OilCustomerLedgerEntry[]
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  deletedAt     DateTime?                @map("deleted_at")

  @@index([seasonId])
  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("oil_sale_customers")
}

/**
 * رصيد مخزون الزيت لكل موسم/نوع — يُحدَّث داخل معاملات DB.
 * المصدر الحقيقي للحركة هو OilStockMovement؛ هذا الجدول للسرعة والقفل المتزامن.
 */
model OilStockBalance {
  id              String    @id @default(uuid())
  seasonId        String    @map("season_id")
  season          Season    @relation(fields: [seasonId], references: [id])
  oilSource       OilSource @default(STORED) @map("oil_source")
  oilType         OilType   @map("oil_type")
  totalAdded      Decimal   @default(0) @map("total_added") @db.Decimal(14, 2)
  totalSold       Decimal   @default(0) @map("total_sold") @db.Decimal(14, 2)
  theoreticalQty  Decimal   @default(0) @map("theoretical_qty") @db.Decimal(14, 2)
  physicalQty     Decimal?  @map("physical_qty") @db.Decimal(14, 2)
  lastInventoryAt DateTime? @map("last_inventory_at")
  version         Int       @default(0)
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([seasonId, oilSource, oilType])
  @@index([seasonId])
  @@index([seasonId, oilSource])
  @@map("oil_stock_balances")
}

model OilStockMovement {
  id               String               @id @default(uuid())
  seasonId         String               @map("season_id")
  season           Season               @relation(fields: [seasonId], references: [id])
  oilSource        OilSource            @default(STORED) @map("oil_source")
  oilType          OilType              @map("oil_type")
  type             OilStockMovementType
  quantityL        Decimal              @map("quantity_l") @db.Decimal(14, 2)
  stockBefore      Decimal              @map("stock_before") @db.Decimal(14, 2)
  stockAfter       Decimal              @map("stock_after") @db.Decimal(14, 2)
  saleId           String?              @map("sale_id")
  sale             OilSale?             @relation(fields: [saleId], references: [id])
  inventoryCountId String?              @map("inventory_count_id")
  inventoryCount   OilInventoryCount?   @relation(fields: [inventoryCountId], references: [id])
  note             String?
  userId           String               @map("user_id")
  user             User                 @relation(fields: [userId], references: [id])
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([seasonId, oilSource, oilType, createdAt])
  @@index([type])
  @@index([saleId])
  @@index([inventoryCountId])
  @@index([userId])
  @@map("oil_stock_movements")
}

model OilInventoryCount {
  id                String                     @id @default(uuid())
  seasonId          String                     @map("season_id")
  season            Season                     @relation(fields: [seasonId], references: [id])
  oilSource         OilSource                  @default(STORED) @map("oil_source")
  oilType           OilType                    @map("oil_type")
  theoreticalBefore Decimal                    @map("theoretical_before") @db.Decimal(14, 2)
  physicalQty       Decimal                    @map("physical_qty") @db.Decimal(14, 2)
  difference        Decimal                    @db.Decimal(14, 2)
  differenceType    OilInventoryDifferenceType @default(BALANCED) @map("difference_type")
  lossQty           Decimal                    @map("loss_qty") @db.Decimal(14, 2)
  surplusQty        Decimal                    @default(0) @map("surplus_qty") @db.Decimal(14, 2)
  note              String?
  userId            String                     @map("user_id")
  user              User                       @relation(fields: [userId], references: [id])
  movements         OilStockMovement[]
  createdAt         DateTime                   @default(now()) @map("created_at")

  @@index([seasonId, oilSource, oilType, createdAt])
  @@index([userId])
  @@map("oil_inventory_counts")
}

model OilSale {
  id                      String                      @id @default(uuid())
  seasonId                String                      @map("season_id")
  season                  Season                      @relation(fields: [seasonId], references: [id])
  receiptNumber           Int                         @map("receipt_number")
  /**
   * Null = walk-in counter sale (زبون عابر) — never allowed to carry debt
   */
  customerId              String?                     @map("customer_id")
  customer                OilSaleCustomer?            @relation(fields: [customerId], references: [id])
  oilSource               OilSource?                  @map("oil_source")
  oilType                 OilType?                    @map("oil_type")
  quantityL               Decimal                     @default(0) @map("quantity_l") @db.Decimal(14, 2)
  unitPrice               Decimal                     @map("unit_price") @db.Decimal(14, 2)
  grossAmount             Decimal                     @map("gross_amount") @db.Decimal(14, 2)
  assistanceFixed         Decimal                     @default(0) @map("assistance_fixed") @db.Decimal(14, 2)
  assistancePercent       Decimal                     @default(0) @map("assistance_percent") @db.Decimal(7, 3)
  assistancePercentAmount Decimal                     @default(0) @map("assistance_percent_amount") @db.Decimal(14, 2)
  assistancePerLitre      Decimal                     @default(0) @map("assistance_per_litre") @db.Decimal(14, 2)
  assistancePerLitreTotal Decimal                     @default(0) @map("assistance_per_litre_total") @db.Decimal(14, 2)
  totalAssistance         Decimal                     @default(0) @map("total_assistance") @db.Decimal(14, 2)
  finalAmount             Decimal                     @map("final_amount") @db.Decimal(14, 2)
  amountPaid              Decimal                     @default(0) @map("amount_paid") @db.Decimal(14, 2)
  remainingAmount         Decimal                     @default(0) @map("remaining_amount") @db.Decimal(14, 2)
  paymentStatus           OilSalePaymentStatus        @default(PAID) @map("payment_status")
  status                  OilSaleStatus               @default(COMPLETED)
  notes                   String?
  overrideStock           Boolean                     @default(false) @map("override_stock")
  overrideContainerStock  Boolean                     @default(false) @map("override_container_stock")
  saleDate                DateTime                    @default(now()) @map("sale_date")
  saleTime                String                      @map("sale_time")
  createdById             String                      @map("created_by_id")
  createdBy               User                        @relation("OilSaleCreatedBy", fields: [createdById], references: [id])
  /**
   * Snapshot at sale time — historical receipts stay accurate if the user is renamed
   */
  createdByName           String?                     @map("created_by_name")
  createdByUsername       String?                     @map("created_by_username")
  deviceId                String?                     @map("device_id")
  device                  Device?                     @relation(fields: [deviceId], references: [id])
  cashRegisterId          String?                     @map("cash_register_id")
  cashRegister            CashRegister?               @relation(fields: [cashRegisterId], references: [id])
  cashSessionId           String?                     @map("cash_session_id")
  cashSession             CashRegisterSession?        @relation(fields: [cashSessionId], references: [id])
  deviceCode              String?                     @map("device_code")
  deviceName              String?                     @map("device_name")
  cashRegisterCode        String?                     @map("cash_register_code")
  cashRegisterName        String?                     @map("cash_register_name")
  cancelledAt             DateTime?                   @map("cancelled_at")
  cancelledById           String?                     @map("cancelled_by_id")
  cancelledBy             User?                       @relation("OilSaleCancelledBy", fields: [cancelledById], references: [id])
  cancelReason            String?                     @map("cancel_reason")
  movements               OilStockMovement[]
  containerMovements      OilContainerStockMovement[]
  items                   OilSaleItem[]
  paymentAllocations      OilSalePaymentAllocation[]
  ledgerEntries           OilCustomerLedgerEntry[]
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  @@unique([seasonId, receiptNumber])
  @@index([seasonId, oilSource, oilType])
  @@index([seasonId, oilType])
  @@index([seasonId, saleDate])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([deviceId])
  @@index([cashRegisterId])
  @@index([cashSessionId])
  @@index([receiptNumber])
  @@map("oil_sales")
}

/**
 * تسديد دين / دفعة على بيع زيت
 */
model OilSalePayment {
  id               String                     @id @default(uuid())
  seasonId         String                     @map("season_id")
  season           Season                     @relation(fields: [seasonId], references: [id])
  receiptNumber    Int                        @map("receipt_number")
  customerId       String                     @map("customer_id")
  customer         OilSaleCustomer            @relation(fields: [customerId], references: [id])
  amount           Decimal                    @db.Decimal(14, 2)
  paymentMethod    String                     @default("CASH") @map("payment_method")
  reference        String?
  notes            String?
  userId           String                     @map("user_id")
  user             User                       @relation(fields: [userId], references: [id])
  /**
   * Snapshot at payment time
   */
  userName         String?                    @map("user_name")
  userUsername     String?                    @map("user_username")
  deviceId         String?                    @map("device_id")
  device           Device?                    @relation(fields: [deviceId], references: [id])
  cashRegisterId   String?                    @map("cash_register_id")
  cashRegister     CashRegister?              @relation(fields: [cashRegisterId], references: [id])
  cashSessionId    String?                    @map("cash_session_id")
  cashSession      CashRegisterSession?       @relation(fields: [cashSessionId], references: [id])
  deviceCode       String?                    @map("device_code")
  deviceName       String?                    @map("device_name")
  cashRegisterCode String?                    @map("cash_register_code")
  cashRegisterName String?                    @map("cash_register_name")
  allocations      OilSalePaymentAllocation[]
  ledgerEntries    OilCustomerLedgerEntry[]
  createdAt        DateTime                   @default(now()) @map("created_at")

  @@unique([seasonId, receiptNumber])
  @@index([seasonId, customerId, createdAt])
  @@index([userId])
  @@index([cashSessionId])
  @@map("oil_sale_payments")
}

model OilSalePaymentAllocation {
  id        String         @id @default(uuid())
  paymentId String         @map("payment_id")
  payment   OilSalePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  saleId    String         @map("sale_id")
  sale      OilSale        @relation(fields: [saleId], references: [id])
  amount    Decimal        @db.Decimal(14, 2)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([saleId])
  @@map("oil_sale_payment_allocations")
}

model OilCustomerLedgerEntry {
  id           String                @id @default(uuid())
  seasonId     String                @map("season_id")
  season       Season                @relation(fields: [seasonId], references: [id])
  customerId   String                @map("customer_id")
  customer     OilSaleCustomer       @relation(fields: [customerId], references: [id])
  type         OilCustomerLedgerType
  saleId       String?               @map("sale_id")
  sale         OilSale?              @relation(fields: [saleId], references: [id])
  paymentId    String?               @map("payment_id")
  payment      OilSalePayment?       @relation(fields: [paymentId], references: [id])
  debit        Decimal               @default(0) @db.Decimal(14, 2)
  credit       Decimal               @default(0) @db.Decimal(14, 2)
  balanceAfter Decimal               @map("balance_after") @db.Decimal(14, 2)
  reference    String?
  notes        String?
  userId       String                @map("user_id")
  user         User                  @relation(fields: [userId], references: [id])
  deviceId     String?               @map("device_id")
  device       Device?               @relation(fields: [deviceId], references: [id])
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([seasonId, customerId, createdAt])
  @@index([saleId])
  @@index([paymentId])
  @@index([userId])
  @@map("oil_customer_ledger_entries")
}

/**
 * منتج التعبئة / الضلف — مخزون مستقل بالقطعة
 */
model OilContainer {
  id        String                       @id @default(uuid())
  name      String
  capacityL Decimal                      @map("capacity_l") @db.Decimal(12, 2)
  sku       String?
  costPrice Decimal?                     @map("cost_price") @db.Decimal(14, 2)
  unitPrice Decimal?                     @map("unit_price") @db.Decimal(14, 2)
  minStock  Int                          @default(0) @map("min_stock")
  isActive  Boolean                      @default(true) @map("is_active")
  sortOrder Int                          @default(0) @map("sort_order")
  notes     String?
  saleItems OilSaleItem[]
  balances  OilContainerStockBalance[]
  movements OilContainerStockMovement[]
  counts    OilContainerInventoryCount[]
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")
  deletedAt DateTime?                    @map("deleted_at")

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("oil_containers")
}

model OilContainerStockBalance {
  id                 String       @id @default(uuid())
  seasonId           String       @map("season_id")
  season             Season       @relation(fields: [seasonId], references: [id])
  containerId        String       @map("container_id")
  container          OilContainer @relation(fields: [containerId], references: [id])
  totalAdded         Int          @default(0) @map("total_added")
  totalSoldEmpty     Int          @default(0) @map("total_sold_empty")
  totalConsumedInOil Int          @default(0) @map("total_consumed_in_oil")
  totalDamaged       Int          @default(0) @map("total_damaged")
  theoreticalQty     Int          @default(0) @map("theoretical_qty")
  physicalQty        Int?         @map("physical_qty")
  lastInventoryAt    DateTime?    @map("last_inventory_at")
  version            Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@unique([seasonId, containerId])
  @@index([seasonId])
  @@index([containerId])
  @@map("oil_container_stock_balances")
}

model OilContainerStockMovement {
  id               String                        @id @default(uuid())
  seasonId         String                        @map("season_id")
  season           Season                        @relation(fields: [seasonId], references: [id])
  containerId      String                        @map("container_id")
  container        OilContainer                  @relation(fields: [containerId], references: [id])
  type             OilContainerStockMovementType
  quantity         Int
  stockBefore      Int                           @map("stock_before")
  stockAfter       Int                           @map("stock_after")
  unitCost         Decimal?                      @map("unit_cost") @db.Decimal(14, 2)
  saleId           String?                       @map("sale_id")
  sale             OilSale?                      @relation(fields: [saleId], references: [id])
  inventoryCountId String?                       @map("inventory_count_id")
  inventoryCount   OilContainerInventoryCount?   @relation(fields: [inventoryCountId], references: [id])
  note             String?
  userId           String                        @map("user_id")
  user             User                          @relation(fields: [userId], references: [id])
  createdAt        DateTime                      @default(now()) @map("created_at")

  @@index([seasonId, containerId, createdAt])
  @@index([type])
  @@index([saleId])
  @@index([inventoryCountId])
  @@index([userId])
  @@map("oil_container_stock_movements")
}

model OilContainerInventoryCount {
  id                String                      @id @default(uuid())
  seasonId          String                      @map("season_id")
  season            Season                      @relation(fields: [seasonId], references: [id])
  containerId       String                      @map("container_id")
  container         OilContainer                @relation(fields: [containerId], references: [id])
  theoreticalBefore Int                         @map("theoretical_before")
  physicalQty       Int                         @map("physical_qty")
  difference        Int
  differenceType    OilInventoryDifferenceType  @default(BALANCED) @map("difference_type")
  lossQty           Int                         @map("loss_qty")
  surplusQty        Int                         @default(0) @map("surplus_qty")
  note              String?
  userId            String                      @map("user_id")
  user              User                        @relation(fields: [userId], references: [id])
  movements         OilContainerStockMovement[]
  createdAt         DateTime                    @default(now()) @map("created_at")

  @@index([seasonId, containerId, createdAt])
  @@index([userId])
  @@map("oil_container_inventory_counts")
}

model OilSaleItem {
  id                 String          @id @default(uuid())
  saleId             String          @map("sale_id")
  sale               OilSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  oilSource          OilSource?      @map("oil_source")
  oilType            OilType?        @map("oil_type")
  kind               OilSaleLineKind
  pricingMode        OilPricingMode  @default(PER_LITRE) @map("pricing_mode")
  containerId        String?         @map("container_id")
  container          OilContainer?   @relation(fields: [containerId], references: [id])
  containerName      String?         @map("container_name")
  containerCapacityL Decimal?        @map("container_capacity_l") @db.Decimal(12, 2)
  containerCount     Int?            @map("container_count")
  quantityL          Decimal         @default(0) @map("quantity_l") @db.Decimal(14, 2)
  unitPrice          Decimal         @map("unit_price") @db.Decimal(14, 2)
  containerPrice     Decimal?        @map("container_price") @db.Decimal(14, 2)
  lineGross          Decimal         @map("line_gross") @db.Decimal(14, 2)
  /**
   * Assistance of THIS line only — each oil line carries its own rate and fixed amount
   */
  assistancePerLitre Decimal         @default(0) @map("assistance_per_litre") @db.Decimal(14, 2)
  assistanceFixed    Decimal         @default(0) @map("assistance_fixed") @db.Decimal(14, 2)
  lineAssistance     Decimal         @default(0) @map("line_assistance") @db.Decimal(14, 2)
  sortOrder          Int             @default(0) @map("sort_order")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([saleId])
  @@index([containerId])
  @@index([oilSource, oilType])
  @@index([oilType])
  @@index([kind])
  @@map("oil_sale_items")
}

/**
 * بيع معلّق (قائمة الانتظار) — مسودة فقط.
 * لا تُنشئ حركة مخزون ولا حركة صندوق ولا قيد دين؛ تُحذف داخل معاملة إتمام البيع.
 * priceLocks: أسعار يلتقطها الخادم عند التعليق ({ "OIL:GREEN": 900, "CNT:<id>": 150 }).
 */
model OilSaleHold {
  id               String   @id @default(uuid())
  seasonId         String   @map("season_id")
  holdNumber       Int      @map("hold_number")
  customerId       String?  @map("customer_id")
  customerName     String?  @map("customer_name")
  customerPhone    String?  @map("customer_phone")
  payload          Json
  priceLocks       Json     @map("price_locks")
  itemCount        Int      @map("item_count")
  totalAmount      Decimal  @map("total_amount") @db.Decimal(14, 2)
  createdById      String   @map("created_by_id")
  createdByName    String?  @map("created_by_name")
  deviceId         String?  @map("device_id")
  deviceName       String?  @map("device_name")
  cashRegisterId   String?  @map("cash_register_id")
  cashRegisterName String?  @map("cash_register_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, holdNumber])
  @@index([seasonId, cashRegisterId])
  @@index([seasonId, createdById])
  @@map("oil_sale_holds")
}

model CashRegister {
  id               String                @id @default(uuid())
  code             String                @unique
  name             String
  isActive         Boolean               @default(true) @map("is_active")
  sortOrder        Int                   @default(0) @map("sort_order")
  notes            String?
  devices          Device[]
  sessions         CashRegisterSession[]
  sales            OilSale[]
  oilSalePayments  OilSalePayment[]
  dayReportPrints  OilDayReportPrint[]
  hrSalaryPayments HrSalaryPayment[]
  hrAdvances       HrAdvance[]
  hrLoans          HrLoan[]
  hrExpenses       HrExpense[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("cash_registers")
}

model Device {
  id                          String                   @id @default(uuid())
  installationId              String                   @unique @map("installation_id")
  code                        String?                  @unique
  name                        String
  workspace                   DeviceWorkspace          @default(BOTH)
  status                      DeviceStatus             @default(PENDING)
  location                    String?
  notes                       String?
  lastSeenAt                  DateTime?                @map("last_seen_at")
  approvedAt                  DateTime?                @map("approved_at")
  approvedById                String?                  @map("approved_by_id")
  approvedBy                  User?                    @relation("DeviceApprovedBy", fields: [approvedById], references: [id])
  cashRegisterId              String?                  @map("cash_register_id")
  cashRegister                CashRegister?            @relation(fields: [cashRegisterId], references: [id])
  sessions                    CashRegisterSession[]
  oilSales                    OilSale[]
  oilSalePayments             OilSalePayment[]
  oilCustomerLedgerEntries    OilCustomerLedgerEntry[]
  oliveEntries                OliveEntry[]
  pressingRecords             PressingRecord[]
  filtrationRecords           FiltrationRecord[]
  payments                    Payment[]
  clients                     Client[]
  auditLogs                   AuditLog[]
  dayReportPrints             OilDayReportPrint[]
  printSettings               DevicePrintSettings?
  millAssistAsAssistantDevice MillAssistanceSession[]  @relation("MillAssistAssistantDevice")
  millAssistAsPrimaryDevice   MillAssistanceSession[]  @relation("MillAssistPrimaryDevice")
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@index([workspace])
  @@index([cashRegisterId])
  @@index([lastSeenAt])
  @@map("devices")
}

model CashRegisterSession {
  id               String            @id @default(uuid())
  seasonId         String            @map("season_id")
  season           Season            @relation(fields: [seasonId], references: [id])
  cashRegisterId   String            @map("cash_register_id")
  cashRegister     CashRegister      @relation(fields: [cashRegisterId], references: [id])
  deviceId         String            @map("device_id")
  device           Device            @relation(fields: [deviceId], references: [id])
  status           CashSessionStatus @default(OPEN)
  openedAt         DateTime          @default(now()) @map("opened_at")
  closedAt         DateTime?         @map("closed_at")
  openedById       String            @map("opened_by_id")
  openedBy         User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedById       String?           @map("closed_by_id")
  closedBy         User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  openingCash      Decimal           @map("opening_cash") @db.Decimal(14, 2)
  cashSales        Decimal           @default(0) @map("cash_sales") @db.Decimal(14, 2)
  cashRefunds      Decimal           @default(0) @map("cash_refunds") @db.Decimal(14, 2)
  cashIn           Decimal           @default(0) @map("cash_in") @db.Decimal(14, 2)
  cashOut          Decimal           @default(0) @map("cash_out") @db.Decimal(14, 2)
  expectedCash     Decimal?          @map("expected_cash") @db.Decimal(14, 2)
  physicalCash     Decimal?          @map("physical_cash") @db.Decimal(14, 2)
  difference       Decimal?          @db.Decimal(14, 2)
  openingNote      String?           @map("opening_note")
  closingNote      String?           @map("closing_note")
  sales            OilSale[]
  oilSalePayments  OilSalePayment[]
  hrSalaryPayments HrSalaryPayment[]
  hrAdvances       HrAdvance[]
  hrLoans          HrLoan[]
  hrExpenses       HrExpense[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([seasonId, status])
  @@index([cashRegisterId, status])
  @@index([deviceId])
  @@index([openedById])
  @@map("cash_register_sessions")
}

/**
 * Printer configuration of a registered workstation. Belongs to the DEVICE, never the user:
 * user permissions decide what may be printed, the device decides where it prints.
 */
model DevicePrintSettings {
  id                  String   @id @default(uuid())
  deviceId            String   @unique @map("device_id")
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  directPrinting      Boolean  @default(false) @map("direct_printing")
  browserFallback     Boolean  @default(true) @map("browser_fallback")
  autoPrintAfterSale  Boolean  @default(false) @map("auto_print_after_sale")
  receiptPrinter      String?  @map("receipt_printer")
  /**
   * 58 | 80
   */
  receiptPaperWidth   Int      @default(80) @map("receipt_paper_width")
  receiptDirect       Boolean  @default(true) @map("receipt_direct")
  receiptCopies       Int      @default(1) @map("receipt_copies")
  documentPrinter     String?  @map("document_printer")
  /**
   * A4 | A5
   */
  documentPaperFormat String   @default("A4") @map("document_paper_format")
  /**
   * PORTRAIT | LANDSCAPE
   */
  documentOrientation String   @default("PORTRAIT") @map("document_orientation")
  documentCopies      Int      @default(1) @map("document_copies")
  /**
   * RECEIPT | DOCUMENT — which printer receives the financial day report
   */
  dayReportTarget     String   @default("DOCUMENT") @map("day_report_target")
  updatedById         String?  @map("updated_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("device_print_settings")
}

/**
 * Print submissions. SUBMITTED means the job reached the Windows spooler / browser dialog —
 * not that paper physically came out of the printer.
 */
model PrintJobLog {
  id               String   @id @default(uuid())
  jobId            String   @unique @map("job_id")
  documentType     String   @map("document_type")
  documentRef      String?  @map("document_ref")
  copyLabel        String?  @map("copy_label")
  isReprint        Boolean  @default(false) @map("is_reprint")
  /**
   * AGENT | BROWSER
   */
  channel          String
  /**
   * SUBMITTED | FAILED | BROWSER_OPENED
   */
  status           String
  errorCode        String?  @map("error_code")
  errorMessage     String?  @map("error_message")
  printerName      String?  @map("printer_name")
  copies           Int      @default(1)
  userId           String   @map("user_id")
  userName         String?  @map("user_name")
  deviceId         String?  @map("device_id")
  deviceCode       String?  @map("device_code")
  deviceName       String?  @map("device_name")
  cashRegisterId   String?  @map("cash_register_id")
  cashRegisterName String?  @map("cash_register_name")
  requestedAt      DateTime @default(now()) @map("requested_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([deviceId, requestedAt])
  @@index([documentType, documentRef])
  @@index([userId])
  @@map("print_job_logs")
}

/**
 * سجل طباعة / توليد اليومية المالية لصندوق معين
 */
model OilDayReportPrint {
  id               String       @id @default(uuid())
  seasonId         String       @map("season_id")
  season           Season       @relation(fields: [seasonId], references: [id])
  fromDate         DateTime     @map("from_date") @db.Date
  toDate           DateTime     @map("to_date") @db.Date
  cashRegisterId   String       @map("cash_register_id")
  cashRegister     CashRegister @relation(fields: [cashRegisterId], references: [id])
  cashRegisterCode String       @map("cash_register_code")
  cashRegisterName String       @map("cash_register_name")
  generatedById    String       @map("generated_by_id")
  generatedBy      User         @relation(fields: [generatedById], references: [id])
  generatedByName  String       @map("generated_by_name")
  deviceId         String?      @map("device_id")
  device           Device?      @relation(fields: [deviceId], references: [id])
  deviceCode       String?      @map("device_code")
  deviceName       String?      @map("device_name")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([seasonId, cashRegisterId, fromDate])
  @@index([generatedById])
  @@index([deviceId])
  @@map("oil_day_report_prints")
}

// ─────────────────────────────────────────────────────────────────────────────
// Ressources humaines / الموارد البشرية
// Not season-scoped. Actor references (createdById, …) are plain columns with name
// snapshots so a user purge never cascades into personnel history.
// ─────────────────────────────────────────────────────────────────────────────

enum HrEmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  LEFT
}

enum HrSalaryMode {
  MONTHLY
  DAILY
  HOURLY
}

enum HrApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HrPayrollStatus {
  DRAFT
  CALCULATED
  REVIEWED
  VALIDATED
  PAID
  CLOSED
}

model HrDepartment {
  id                  String                 @id @default(uuid())
  code                String?                @unique
  name                String
  nameFr              String?                @map("name_fr")
  isActive            Boolean                @default(true) @map("is_active")
  notes               String?
  employees           HrEmployee[]
  contracts           HrContract[]
  scheduleAssignments HrScheduleAssignment[]
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@map("hr_departments")
}

model HrEmployee {
  id                       String                   @id @default(uuid())
  matricule                String                   @unique
  firstName                String                   @map("first_name")
  lastName                 String                   @map("last_name")
  /**
   * Small data-URL thumbnail (resized client-side)
   */
  photo                    String?
  birthDate                DateTime?                @map("birth_date") @db.Date
  phone                    String?
  address                  String?
  nationalIdNumber         String?                  @map("national_id_number")
  nationalIdIssuedAt       DateTime?                @map("national_id_issued_at") @db.Date
  nationalIdIssuedBy       String?                  @map("national_id_issued_by")
  socialSecurityNumber     String?                  @map("social_security_number")
  emergencyContactName     String?                  @map("emergency_contact_name")
  emergencyContactPhone    String?                  @map("emergency_contact_phone")
  emergencyContactRelation String?                  @map("emergency_contact_relation")
  jobTitle                 String?                  @map("job_title")
  departmentId             String?                  @map("department_id")
  department               HrDepartment?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workSite                 String?                  @map("work_site")
  hireDate                 DateTime                 @map("hire_date") @db.Date
  status                   HrEmployeeStatus         @default(ACTIVE)
  leftAt                   DateTime?                @map("left_at") @db.Date
  leftReason               String?                  @map("left_reason")
  /**
   * CASH | BANK_TRANSFER | CCP | CHEQUE
   */
  paymentMethod            String                   @default("CASH") @map("payment_method")
  bankAccount              String?                  @map("bank_account")
  userId                   String?                  @unique @map("user_id")
  user                     User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes                    String?
  archivedAt               DateTime?                @map("archived_at")
  createdById              String?                  @map("created_by_id")
  contracts                HrContract[]
  scheduleAssignments      HrScheduleAssignment[]
  deviceMappings           HrAttendanceDeviceUser[]
  attendanceEvents         HrAttendanceEvent[]
  attendanceDays           HrAttendanceDay[]
  attendanceCorrections    HrAttendanceCorrection[]
  leaveEntitlements        HrLeaveEntitlement[]
  leaveRequests            HrLeaveRequest[]
  sickLeaves               HrSickLeave[]
  absences                 HrAbsence[]
  overtimes                HrOvertime[]
  advances                 HrAdvance[]
  loans                    HrLoan[]
  bonuses                  HrBonus[]
  deductions               HrDeduction[]
  payslips                 HrPayslip[]
  salaryPayments           HrSalaryPayment[]
  expenses                 HrExpense[]
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@index([departmentId])
  @@index([lastName, firstName])
  @@index([archivedAt])
  @@map("hr_employees")
}

/**
 * Contract history — a salary change is a new contract/amendment, never an in-place rewrite once paid.
 */
model HrContract {
  id                String        @id @default(uuid())
  employeeId        String        @map("employee_id")
  employee          HrEmployee    @relation(fields: [employeeId], references: [id])
  /**
   * CDI | CDD | SEASONAL | PART_TIME | TRIAL | INTERNSHIP | OTHER
   */
  contractType      String        @map("contract_type")
  startDate         DateTime      @map("start_date") @db.Date
  endDate           DateTime?     @map("end_date") @db.Date
  trialEndDate      DateTime?     @map("trial_end_date") @db.Date
  salaryMode        HrSalaryMode  @default(MONTHLY) @map("salary_mode")
  /**
   * Monthly amount, daily rate or hourly rate depending on salaryMode
   */
  baseSalary        Decimal       @map("base_salary") @db.Decimal(14, 2)
  weeklyHours       Decimal       @default(40) @map("weekly_hours") @db.Decimal(5, 2)
  jobTitle          String?       @map("job_title")
  departmentId      String?       @map("department_id")
  department        HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /**
   * ACTIVE | ENDED | TERMINATED
   */
  status            String        @default("ACTIVE")
  terminatedAt      DateTime?     @map("terminated_at") @db.Date
  terminationReason String?       @map("termination_reason")
  documentRef       String?       @map("document_ref")
  notes             String?
  createdById       String?       @map("created_by_id")
  createdByName     String?       @map("created_by_name")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status])
  @@map("hr_contracts")
}

model HrWorkSchedule {
  id           String                 @id @default(uuid())
  code         String                 @unique
  name         String
  description  String?
  isActive     Boolean                @default(true) @map("is_active")
  /**
   * Unpaid break deducted from worked time on continuous days (minutes)
   */
  breakMinutes Int                    @default(0) @map("break_minutes")
  segments     HrScheduleSegment[]
  assignments  HrScheduleAssignment[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@map("hr_work_schedules")
}

/**
 * One working block on a weekday. endMinute <= startMinute ⇒ the block ends the next day (night shift).
 */
model HrScheduleSegment {
  id          String         @id @default(uuid())
  scheduleId  String         @map("schedule_id")
  schedule    HrWorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /**
   * 0 = Sunday … 6 = Saturday
   */
  weekday     Int
  startMinute Int            @map("start_minute")
  endMinute   Int            @map("end_minute")
  sortOrder   Int            @default(0) @map("sort_order")

  @@index([scheduleId, weekday])
  @@map("hr_schedule_segments")
}

/**
 * Employee or department schedule for a date range; isOverride = temporary override.
 */
model HrScheduleAssignment {
  id           String         @id @default(uuid())
  scheduleId   String         @map("schedule_id")
  schedule     HrWorkSchedule @relation(fields: [scheduleId], references: [id])
  employeeId   String?        @map("employee_id")
  employee     HrEmployee?    @relation(fields: [employeeId], references: [id])
  departmentId String?        @map("department_id")
  department   HrDepartment?  @relation(fields: [departmentId], references: [id])
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  isOverride   Boolean        @default(false) @map("is_override")
  reason       String?
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([employeeId, startDate])
  @@index([departmentId, startDate])
  @@map("hr_schedule_assignments")
}

model HrHoliday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  isPaid    Boolean  @default(true) @map("is_paid")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("hr_holidays")
}

/**
 * Physical attendance terminal (ZKTeco or other) — provider decides how events arrive.
 */
model HrAttendanceDevice {
  id                    String                   @id @default(uuid())
  name                  String
  model                 String?
  serialNumber          String?                  @unique @map("serial_number")
  ipAddress             String?                  @map("ip_address")
  port                  Int?
  /**
   * ZKTECO_ADMS | ZKTECO_TCP | ZKTECO_FILE
   */
  provider              String
  /**
   * Numeric communication key for the TCP SDK protocol (0 = none)
   */
  commKey               String?                  @map("comm_key")
  location              String?
  isEnabled             Boolean                  @default(true) @map("is_enabled")
  /**
   * Device clock offset from UTC — Algeria = +60
   */
  timezoneOffsetMinutes Int                      @default(60) @map("timezone_offset_minutes")
  /**
   * Column positions for exported attendance files (USB)
   */
  fileColumnMap         Json?                    @map("file_column_map")
  syncIntervalMinutes   Int                      @default(0) @map("sync_interval_minutes")
  /**
   * UNKNOWN | ONLINE | SYNCING | OFFLINE | ERROR
   */
  status                String                   @default("UNKNOWN")
  lastConnectionAt      DateTime?                @map("last_connection_at")
  lastSyncAt            DateTime?                @map("last_sync_at")
  lastSuccessfulSyncAt  DateTime?                @map("last_successful_sync_at")
  lastError             String?                  @map("last_error")
  /**
   * ADMS ATTLOGStamp cursor reported back to the device
   */
  lastLogStamp          String?                  @map("last_log_stamp")
  lastEventAt           DateTime?                @map("last_event_at")
  deviceInfo            Json?                    @map("device_info")
  lastDiagnostic        Json?                    @map("last_diagnostic")
  lastDiagnosticAt      DateTime?                @map("last_diagnostic_at")
  /**
   * Set when the first real punch from this terminal was imported
   */
  firstEventImportedAt  DateTime?                @map("first_event_imported_at")
  notes                 String?
  userMappings          HrAttendanceDeviceUser[]
  events                HrAttendanceEvent[]
  syncLogs              HrAttendanceSyncLog[]
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@map("hr_attendance_devices")
}

/**
 * Stable mapping Oilix employee ↔ user/PIN stored in the terminal (never by name).
 */
model HrAttendanceDeviceUser {
  id             String             @id @default(uuid())
  deviceId       String             @map("device_id")
  device         HrAttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceUserId   String             @map("device_user_id")
  employeeId     String             @map("employee_id")
  employee       HrEmployee         @relation(fields: [employeeId], references: [id])
  deviceUserName String?            @map("device_user_name")
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([deviceId, deviceUserId])
  @@index([employeeId])
  @@map("hr_attendance_device_users")
}

model HrAttendanceSyncLog {
  id             String              @id @default(uuid())
  deviceId       String?             @map("device_id")
  device         HrAttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  provider       String
  /**
   * MANUAL | SCHEDULED | PUSH | FILE | DIAGNOSTIC
   */
  trigger        String
  /**
   * RUNNING | SUCCESS | FAILED | REJECTED
   */
  status         String
  startedAt      DateTime            @default(now()) @map("started_at")
  finishedAt     DateTime?           @map("finished_at")
  fetchedCount   Int                 @default(0) @map("fetched_count")
  insertedCount  Int                 @default(0) @map("inserted_count")
  duplicateCount Int                 @default(0) @map("duplicate_count")
  unmappedCount  Int                 @default(0) @map("unmapped_count")
  invalidCount   Int                 @default(0) @map("invalid_count")
  errorMessage   String?             @map("error_message")
  fileName       String?             @map("file_name")
  fileHash       String?             @map("file_hash")
  details        Json?
  userId         String?             @map("user_id")
  userName       String?             @map("user_name")
  events         HrAttendanceEvent[]

  @@index([deviceId, startedAt])
  @@map("hr_attendance_sync_logs")
}

/**
 * Raw punch exactly as received from the terminal — immutable.
 * dedupeKey makes every sync idempotent. Only employeeId (a derived mapping link) may be
 * filled in later when a device user gets mapped.
 */
model HrAttendanceEvent {
  id              String               @id @default(uuid())
  dedupeKey       String               @unique @map("dedupe_key")
  deviceId        String?              @map("device_id")
  device          HrAttendanceDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /**
   * ADMS_PUSH | FILE_IMPORT | TCP_PULL
   */
  source          String
  deviceUserId    String               @map("device_user_id")
  employeeId      String?              @map("employee_id")
  employee        HrEmployee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  punchedAt       DateTime             @map("punched_at")
  localDate       DateTime             @map("local_date") @db.Date
  deviceLocalTime String               @map("device_local_time")
  punchState      Int?                 @map("punch_state")
  verifyCode      Int?                 @map("verify_code")
  /**
   * FINGERPRINT | CARD | PIN | FACE | PALM | OTHER | UNKNOWN
   */
  verifyMethod    String               @map("verify_method")
  workCode        String?              @map("work_code")
  rawLine         String?              @map("raw_line")
  batchId         String?              @map("batch_id")
  batch           HrAttendanceSyncLog? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  receivedAt      DateTime             @default(now()) @map("received_at")

  @@index([employeeId, punchedAt])
  @@index([deviceId, punchedAt])
  @@index([deviceUserId])
  @@index([localDate])
  @@map("hr_attendance_events")
}

/**
 * Processed attendance (one row per employee/day) — recomputed from raw events + corrections.
 */
model HrAttendanceDay {
  id                    String     @id @default(uuid())
  employeeId            String     @map("employee_id")
  employee              HrEmployee @relation(fields: [employeeId], references: [id])
  date                  DateTime   @db.Date
  status                String
  flags                 String[]   @default([])
  isWorkingDay          Boolean    @default(false) @map("is_working_day")
  scheduleId            String?    @map("schedule_id")
  scheduleName          String?    @map("schedule_name")
  scheduledStart        DateTime?  @map("scheduled_start")
  scheduledEnd          DateTime?  @map("scheduled_end")
  expectedMinutes       Int        @default(0) @map("expected_minutes")
  firstIn               DateTime?  @map("first_in")
  lastOut               DateTime?  @map("last_out")
  punchCount            Int        @default(0) @map("punch_count")
  inEventId             String?    @map("in_event_id")
  outEventId            String?    @map("out_event_id")
  inVerifyMethod        String?    @map("in_verify_method")
  inDeviceId            String?    @map("in_device_id")
  workedMinutes         Int        @default(0) @map("worked_minutes")
  lateMinutes           Int        @default(0) @map("late_minutes")
  chargeableLateMinutes Int        @default(0) @map("chargeable_late_minutes")
  isLate                Boolean    @default(false) @map("is_late")
  earlyLeaveMinutes     Int        @default(0) @map("early_leave_minutes")
  overtimeMinutes       Int        @default(0) @map("overtime_minutes")
  overtimeRule          String?    @map("overtime_rule")
  leaveRequestId        String?    @map("leave_request_id")
  sickLeaveId           String?    @map("sick_leave_id")
  absenceId             String?    @map("absence_id")
  holidayId             String?    @map("holiday_id")
  lateJustified         Boolean    @default(false) @map("late_justified")
  lateJustification     String?    @map("late_justification")
  lateDecidedById       String?    @map("late_decided_by_id")
  lateDecidedByName     String?    @map("late_decided_by_name")
  lateDecidedAt         DateTime?  @map("late_decided_at")
  needsReview           Boolean    @default(false) @map("needs_review")
  isCorrected           Boolean    @default(false) @map("is_corrected")
  computedAt            DateTime   @default(now()) @map("computed_at")

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@map("hr_attendance_days")
}

/**
 * Manual correction of the PROCESSED layer — raw events are never modified.
 */
model HrAttendanceCorrection {
  id            String     @id @default(uuid())
  employeeId    String     @map("employee_id")
  employee      HrEmployee @relation(fields: [employeeId], references: [id])
  date          DateTime   @db.Date
  checkIn       DateTime?  @map("check_in")
  checkOut      DateTime?  @map("check_out")
  /**
   * Optional status override, e.g. PRESENT when the terminal was offline
   */
  status        String?
  reason        String
  oldValue      Json?      @map("old_value")
  newValue      Json?      @map("new_value")
  createdById   String     @map("created_by_id")
  createdByName String?    @map("created_by_name")
  createdAt     DateTime   @default(now()) @map("created_at")
  revokedAt     DateTime?  @map("revoked_at")
  revokedById   String?    @map("revoked_by_id")
  revokedByName String?    @map("revoked_by_name")
  revokeReason  String?    @map("revoke_reason")

  @@index([employeeId, date])
  @@map("hr_attendance_corrections")
}

model HrLeaveType {
  id                 String               @id @default(uuid())
  code               String               @unique
  name               String
  nameFr             String?              @map("name_fr")
  isPaid             Boolean              @default(true) @map("is_paid")
  deductsFromBalance Boolean              @default(false) @map("deducts_from_balance")
  defaultDaysPerYear Decimal?             @map("default_days_per_year") @db.Decimal(5, 1)
  isActive           Boolean              @default(true) @map("is_active")
  sortOrder          Int                  @default(0) @map("sort_order")
  entitlements       HrLeaveEntitlement[]
  requests           HrLeaveRequest[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@map("hr_leave_types")
}

model HrLeaveEntitlement {
  id          String      @id @default(uuid())
  employeeId  String      @map("employee_id")
  employee    HrEmployee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String      @map("leave_type_id")
  leaveType   HrLeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  days        Decimal     @db.Decimal(5, 1)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([employeeId, leaveTypeId, year])
  @@map("hr_leave_entitlements")
}

model HrLeaveRequest {
  id              String           @id @default(uuid())
  employeeId      String           @map("employee_id")
  employee        HrEmployee       @relation(fields: [employeeId], references: [id])
  leaveTypeId     String           @map("leave_type_id")
  leaveType       HrLeaveType      @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime         @map("start_date") @db.Date
  endDate         DateTime         @map("end_date") @db.Date
  days            Decimal          @db.Decimal(5, 1)
  reason          String?
  attachment      String?
  attachmentName  String?          @map("attachment_name")
  status          HrApprovalStatus @default(PENDING)
  requestedById   String?          @map("requested_by_id")
  requestedByName String?          @map("requested_by_name")
  decidedById     String?          @map("decided_by_id")
  decidedByName   String?          @map("decided_by_name")
  decidedAt       DateTime?        @map("decided_at")
  decisionNote    String?          @map("decision_note")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status])
  @@map("hr_leave_requests")
}

model HrSickLeave {
  id               String           @id @default(uuid())
  employeeId       String           @map("employee_id")
  employee         HrEmployee       @relation(fields: [employeeId], references: [id])
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime         @map("end_date") @db.Date
  days             Int
  certificateRef   String?          @map("certificate_ref")
  doctorName       String?          @map("doctor_name")
  attachment       String?
  attachmentName   String?          @map("attachment_name")
  notes            String?
  status           HrApprovalStatus @default(PENDING)
  /**
   * UNPAID | PAID | PARTIAL — employer payroll treatment
   */
  payrollTreatment String           @default("UNPAID") @map("payroll_treatment")
  paidPercent      Decimal          @default(0) @map("paid_percent") @db.Decimal(5, 2)
  createdById      String?          @map("created_by_id")
  createdByName    String?          @map("created_by_name")
  decidedById      String?          @map("decided_by_id")
  decidedByName    String?          @map("decided_by_name")
  decidedAt        DateTime?        @map("decided_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status])
  @@map("hr_sick_leaves")
}

model HrAbsenceType {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  nameFr      String?     @map("name_fr")
  isPaid      Boolean     @default(false) @map("is_paid")
  isJustified Boolean     @default(true) @map("is_justified")
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  absences    HrAbsence[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("hr_absence_types")
}

model HrAbsence {
  id             String           @id @default(uuid())
  employeeId     String           @map("employee_id")
  employee       HrEmployee       @relation(fields: [employeeId], references: [id])
  absenceTypeId  String           @map("absence_type_id")
  absenceType    HrAbsenceType    @relation(fields: [absenceTypeId], references: [id])
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime         @map("end_date") @db.Date
  days           Decimal          @db.Decimal(5, 1)
  reason         String?
  isPaid         Boolean          @default(false) @map("is_paid")
  attachment     String?
  attachmentName String?          @map("attachment_name")
  status         HrApprovalStatus @default(PENDING)
  createdById    String?          @map("created_by_id")
  createdByName  String?          @map("created_by_name")
  decidedById    String?          @map("decided_by_id")
  decidedByName  String?          @map("decided_by_name")
  decidedAt      DateTime?        @map("decided_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status])
  @@map("hr_absences")
}

/**
 * Calculated overtime (from attendance) vs approved overtime (what payroll may pay).
 */
model HrOvertime {
  id                String           @id @default(uuid())
  employeeId        String           @map("employee_id")
  employee          HrEmployee       @relation(fields: [employeeId], references: [id])
  date              DateTime         @db.Date
  /**
   * CALCULATED | MANUAL
   */
  source            String
  calculatedMinutes Int              @default(0) @map("calculated_minutes")
  requestedMinutes  Int              @map("requested_minutes")
  approvedMinutes   Int?             @map("approved_minutes")
  multiplier        Decimal          @db.Decimal(5, 2)
  /**
   * WORKDAY | REST_DAY | HOLIDAY
   */
  ruleCode          String           @default("WORKDAY") @map("rule_code")
  reason            String?
  status            HrApprovalStatus @default(PENDING)
  decidedById       String?          @map("decided_by_id")
  decidedByName     String?          @map("decided_by_name")
  decidedAt         DateTime?        @map("decided_at")
  decisionNote      String?          @map("decision_note")
  payslipId         String?          @map("payslip_id")
  payslip           HrPayslip?       @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdById       String?          @map("created_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, date])
  @@index([status])
  @@map("hr_overtimes")
}

/**
 * Salary advance (تسبيق) — deducted once by a validated payslip.
 */
model HrAdvance {
  id                String               @id @default(uuid())
  employeeId        String               @map("employee_id")
  employee          HrEmployee           @relation(fields: [employeeId], references: [id])
  amount            Decimal              @db.Decimal(14, 2)
  date              DateTime             @db.Date
  /**
   * CASH_REGISTER | CASH | BANK_TRANSFER | CCP | CHEQUE
   */
  paymentMethod     String               @map("payment_method")
  cashRegisterId    String?              @map("cash_register_id")
  cashRegister      CashRegister?        @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  cashSessionId     String?              @map("cash_session_id")
  cashSession       CashRegisterSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  cashRegisterName  String?              @map("cash_register_name")
  reference         String?
  deductYear        Int                  @map("deduct_year")
  deductMonth       Int                  @map("deduct_month")
  /**
   * OPEN | DEDUCTED | CANCELLED
   */
  status            String               @default("OPEN")
  deductedPayslipId String?              @map("deducted_payslip_id")
  deductedPayslip   HrPayslip?           @relation(fields: [deductedPayslipId], references: [id], onDelete: SetNull)
  notes             String?
  idempotencyKey    String?              @unique @map("idempotency_key")
  createdById       String?              @map("created_by_id")
  createdByName     String?              @map("created_by_name")
  cancelledAt       DateTime?            @map("cancelled_at")
  cancelledById     String?              @map("cancelled_by_id")
  cancelledByName   String?              @map("cancelled_by_name")
  cancelReason      String?              @map("cancel_reason")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([employeeId, date])
  @@index([status])
  @@map("hr_advances")
}

model HrLoan {
  id                String               @id @default(uuid())
  employeeId        String               @map("employee_id")
  employee          HrEmployee           @relation(fields: [employeeId], references: [id])
  principal         Decimal              @db.Decimal(14, 2)
  installmentAmount Decimal              @map("installment_amount") @db.Decimal(14, 2)
  startYear         Int                  @map("start_year")
  startMonth        Int                  @map("start_month")
  disbursedAt       DateTime             @map("disbursed_at") @db.Date
  paymentMethod     String               @map("payment_method")
  cashRegisterId    String?              @map("cash_register_id")
  cashRegister      CashRegister?        @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  cashSessionId     String?              @map("cash_session_id")
  cashSession       CashRegisterSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  cashRegisterName  String?              @map("cash_register_name")
  reference         String?
  /**
   * ACTIVE | COMPLETED | CANCELLED
   */
  status            String               @default("ACTIVE")
  notes             String?
  idempotencyKey    String?              @unique @map("idempotency_key")
  createdById       String?              @map("created_by_id")
  createdByName     String?              @map("created_by_name")
  repayments        HrLoanRepayment[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@map("hr_loans")
}

model HrLoanRepayment {
  id            String     @id @default(uuid())
  loanId        String     @map("loan_id")
  loan          HrLoan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payslipId     String?    @map("payslip_id")
  payslip       HrPayslip? @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  amount        Decimal    @db.Decimal(14, 2)
  date          DateTime   @db.Date
  /**
   * PAYROLL | MANUAL
   */
  source        String
  notes         String?
  createdById   String?    @map("created_by_id")
  createdByName String?    @map("created_by_name")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@unique([loanId, payslipId])
  @@map("hr_loan_repayments")
}

/**
 * Primes & indemnités (BONUS | ALLOWANCE) for a payroll month.
 */
model HrBonus {
  id            String           @id @default(uuid())
  employeeId    String           @map("employee_id")
  employee      HrEmployee       @relation(fields: [employeeId], references: [id])
  /**
   * BONUS | ALLOWANCE
   */
  category      String           @default("BONUS")
  bonusType     String           @map("bonus_type")
  amount        Decimal          @db.Decimal(14, 2)
  year          Int
  month         Int
  reason        String?
  status        HrApprovalStatus @default(PENDING)
  createdById   String?          @map("created_by_id")
  createdByName String?          @map("created_by_name")
  decidedById   String?          @map("decided_by_id")
  decidedByName String?          @map("decided_by_name")
  decidedAt     DateTime?        @map("decided_at")
  payslipId     String?          @map("payslip_id")
  payslip       HrPayslip?       @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, year, month])
  @@index([status])
  @@map("hr_bonuses")
