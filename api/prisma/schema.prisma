  USERS_READ
  USERS_WRITE
  CLIENTS_READ
  CLIENTS_WRITE
  OLIVE_READ
  OLIVE_WRITE
  PRESSING_READ
  PRESSING_WRITE
  FILTRATION_READ
  FILTRATION_WRITE
  FINANCE_READ
  FINANCE_WRITE
  SETTINGS_READ
  SETTINGS_WRITE
  REPORTS_READ
  AUDIT_READ
  BACKUP_RESTORE
  MILL_ACCESS
  OIL_SALES_READ
  OIL_SALES_WRITE
  OIL_SALES_CANCEL
  OIL_STOCK_WRITE
  OIL_INVENTORY_WRITE
  OIL_CUSTOMERS_WRITE
  OIL_SALES_SETTINGS
  OIL_SALES_OVERRIDE
  OIL_SALES_ACCESS
  OIL_SALES_DASHBOARD_VIEW
  OIL_SALES_SALES_VIEW
  OIL_SALES_SALES_CREATE
  OIL_SALES_SALES_EDIT
  OIL_SALES_SALES_CANCEL
  OIL_SALES_SALES_DELETE
  OIL_SALES_SALES_REPRINT
  OIL_SALES_SALES_CHANGE_PRICE
  OIL_SALES_SALES_ALLOW_DEBT
